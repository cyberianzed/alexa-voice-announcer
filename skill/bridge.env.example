# Copy to bridge.env (chmod 600). Never commit bridge.env.

# Your skill's ID from the Alexa developer console (Build > Endpoint). Requests from other skills are rejected.
SKILL_ID=amzn1.ask.skill.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ASSISTANT_NAME=Jarvis
# PORT=8090

# Your AI agent: any OpenAI-compatible Responses API (a local agent, a proxy to OpenAI / Claude, ...)
AGENT_URL=http://127.0.0.1:8642/v1/responses
AGENT_MODEL=agent
AGENT_KEY=
# Optional stable session/user key sent as "user" (OpenClaw keeps one conversation per user)
AGENT_USER=
# Ready-made settings: docs/agents/hermes-agent.md, docs/agents/openclaw.md

# Where long answers and check-ins go: any shell command that reads the message on stdin.
# Example (Telegram bot): NOTIFY_CMD=/opt/alexa-voice-announcer/bin/notify-telegram
NOTIFY_CMD=
NOTIFY_NAME=Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Your time zone, for "today's main task" (IANA name: Asia/Kolkata, Europe/London, America/New_York ...)
TIMEZONE=UTC

# The announcer (../announcer). Default is fine when both run on the same server.
# ANNOUNCER_URL=http://127.0.0.1:8095

# Quiet hours for bin/alexa-announce (local TIMEZONE, HHMM-HHMM, or "off")
QUIET_HOURS=2300-0700

# Optional backup when the announcer is down: Voice Monkey (https://voicemonkey.io), 200 free requests/month
VOICEMONKEY_TOKEN=
VOICEMONKEY_DEVICE=

# Optional: the Echo's yellow notification ring for inbox updates (Proactive Events; Skill Messaging credentials)
CLIENT_ID=
CLIENT_SECRET=
NOTIFY_STAGE=development
