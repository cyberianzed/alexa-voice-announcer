# Copy to echo.env and edit. Never commit echo.env or cookie.json.

# Your Alexa region (the site you use the Alexa app with): amazon.com, amazon.in, amazon.co.uk, amazon.de, amazon.ca ...
AMAZON_PAGE=amazon.com
# Sign-in host. Keep amazon.com for every region except Japan (amazon.co.jp).
BASE_AMAZON_PAGE=amazon.com
# Language of the sign-in page and of skill launches (en-US, en-IN, en-GB, de-DE ...)
ACCEPT_LANGUAGE=en-US

# Which speaker to use: a device name ("Kitchen Echo") or serial from GET /devices. Empty = first online one.
ECHO_DEVICE=
# announcement | speak | launch   (launch = open your skill, which speaks the queued text; works on the Alexa phone app too)
DEFAULT_MODE=announcement
# Your custom skill's ID (amzn1.ask.skill....), needed for mode "launch"
SKILL_ID=

# PORT=8095
# PROXY_PORT=3456
